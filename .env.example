# PostgreSQL — Railway managed DB connection string
DATABASE_URL=postgres://user:password@localhost:5432/vertualeventlive?sslmode=disable

# Redis — Upstash Redis URL (redis:// or rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# WiPay — Caribbean payout rail (host payout gateway, alternative to Stripe Connect).
# WIPAY_API_BASE_URL must point at WiPay's confirmed disbursement endpoint —
# leave blank to keep WiPay payouts queued as "pending" instead of firing blind.
WIPAY_API_BASE_URL=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
# Hosted checkout: use https://jm.wipayfinancial.com/plugins/payments/request
# for a Jamaica-verified account. Use JMD or USD as approved for your account.
WIPAY_ACCOUNT_NUMBER=
WIPAY_CHECKOUT_URL=
WIPAY_COUNTRY_CODE=JM
WIPAY_CURRENCY=USD
WIPAY_FEE_STRUCTURE=merchant_absorb

# PayPal Commerce Platform multiparty checkout. Hosts receive their ticket
# share directly and the platform fee is split by PayPal during capture.
# Keep the client secret server-side only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# ID of the webhook registered for:
#   CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED,
#   PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED,
#   PAYMENT.CAPTURE.REVERSED
PAYPAL_WEBHOOK_ID=

# Set to paypal to collect platform venue fees with PayPal Checkout.
VENUE_FEE_PROVIDER=paypal

# AWS IVS and private S3 event-image storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_REGION=us-east-1

# Lets hosts use "Bypass Payment & Activate" on Book Event (testing only).
# Keep false in production; superusers can still activate events.
ALLOW_PAYMENT_BYPASS=false

# Outgoing email (tickets, invitations, approvals). SMTP takes priority when
# SMTP_HOST is set, e.g. Mailtrap sending:
#   SMTP_HOST=live.smtp.mailtrap.io  SMTP_PORT=587  SMTP_USERNAME=api
#   SMTP_PASSWORD=<Mailtrap API token>
# FROM_EMAIL must be an address on a domain verified with the provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
RESEND_API_KEY=

# Platform commission for Package B (default: 15)
COMMISSION_PERCENT=15
