# PostgreSQL — Railway managed DB connection string
DATABASE_URL=postgres://user:password@localhost:5432/vertualeventlive?sslmode=disable

# Redis — Upstash Redis URL (redis:// or rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# production (default when unset), development or test. Only development/test
# may run with a weak JWT secret or the legacy WiPay booking-fee flow.
APP_ENV=production

# JWT — REQUIRED. Production refuses to start if this is missing, a
# placeholder, shorter than 32 characters or not random. Generate with:
#   openssl rand -base64 48
# Never commit a real value. Changing it signs everyone out and invalidates
# hosts' payout passcodes (they must set them again).
JWT_SECRET=

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000
# Web origins allowed to call the API with the sign-in cookie (CORS + the
# CSRF origin check). Serve the API from api.virtualeventplus.com so the
# session cookie is same-site with the website (works in Safari/iOS).
CORS_ALLOWED_ORIGINS=https://virtualeventplus.com,https://www.virtualeventplus.com,http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# WiPay — Caribbean payout rail (host payout gateway, alternative to Stripe Connect).
# WIPAY_API_BASE_URL must point at WiPay's confirmed disbursement endpoint —
# leave blank to keep WiPay payouts queued as "pending" instead of firing blind.
WIPAY_API_BASE_URL=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
# Hosted checkout: use https://jm.wipayfinancial.com/plugins/payments/request
# for a Jamaica-verified account. Use JMD or USD as approved for your account.
WIPAY_ACCOUNT_NUMBER=
WIPAY_CHECKOUT_URL=
WIPAY_COUNTRY_CODE=JM
WIPAY_CURRENCY=USD
WIPAY_FEE_STRUCTURE=merchant_absorb
# Legacy WiPay booking-fee checkout. Its return route can't verify payment
# with WiPay, so it is refused in production. Development/test only.
WIPAY_VENUE_FEE_ENABLED=false

# PayPal Commerce Platform multiparty checkout. Hosts receive their ticket
# share directly and the platform fee is split by PayPal during capture.
# Keep the client secret server-side only.
# PayPal is OFF unless PAYPAL_ENABLED=true. When on, the server refuses to
# start unless all PAYPAL_* values below are set and PAYPAL_ENVIRONMENT is
# explicitly live or sandbox (there is no default).
PAYPAL_ENABLED=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=
PAYPAL_PARTNER_MERCHANT_ID=
PAYPAL_PARTNER_ATTRIBUTION_ID=
# ID of the webhook registered for:
#   CHECKOUT.ORDER.APPROVED, PAYMENT.CAPTURE.COMPLETED,
#   PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.REFUNDED,
#   PAYMENT.CAPTURE.REVERSED
PAYPAL_WEBHOOK_ID=

# Who collects the platform booking (venue) fee: stripe, paypal or wipay.
# Ticket sales always use the payout method each host connects.
VENUE_FEE_PROVIDER=stripe
# Venue (booking) fee per hour, in USD.
HOURLY_RATE=15

# AWS IVS and private S3 event-image storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_REGION=us-east-1

# IVS private playback. Create an ECDSA P-384 playback key pair, import the
# PUBLIC key into IVS (Playback keys), and put the PRIVATE key here (PEM; "\n"
# escapes are fine). Viewers then get 10-minute signed playback URLs only
# after their ticket is checked. Set IVS_PLAYBACK_AUTH=required once every
# channel has authorization turned on (new channels are created that way);
# startup fails if it's required without a key.
IVS_PLAYBACK_PRIVATE_KEY=
IVS_PLAYBACK_AUTH=
# Web origin allowed to play signed streams (empty = any, needed for the app)
IVS_PLAYBACK_ALLOW_ORIGIN=

# Tests only: a disposable LOCAL database. Tests refuse any non-localhost
# database or one without "test" in its name.
# TEST_DATABASE_URL=postgres://localhost:5432/vep_phase0_test?sslmode=disable

# Lets hosts use "Bypass Payment & Activate" on Book Event (testing only).
# Keep false in production; superusers can still activate events.
ALLOW_PAYMENT_BYPASS=false

# Outgoing email (tickets, invitations, approvals). SMTP takes priority when
# SMTP_HOST is set, e.g. Mailtrap sending:
#   SMTP_HOST=live.smtp.mailtrap.io  SMTP_PORT=587  SMTP_USERNAME=api
#   SMTP_PASSWORD=<Mailtrap API token>
# FROM_EMAIL must be an address on a domain verified with the provider.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
FROM_EMAIL=
RESEND_API_KEY=

# Platform commission for Package B (default: 15)
COMMISSION_PERCENT=15
