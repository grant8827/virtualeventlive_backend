# PostgreSQL — Railway managed DB connection string
DATABASE_URL=postgres://user:password@localhost:5432/vertualeventlive?sslmode=disable

# Redis — Upstash Redis URL (redis:// or rediss:// for TLS)
REDIS_URL=redis://localhost:6379

# JWT — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-secret

# Server
PORT=8080
FRONTEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# WiPay — Caribbean payout rail (host payout gateway, alternative to Stripe Connect).
# WIPAY_API_BASE_URL must point at WiPay's confirmed disbursement endpoint —
# leave blank to keep WiPay payouts queued as "pending" instead of firing blind.
WIPAY_API_BASE_URL=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
# Hosted checkout: use https://jm.wipayfinancial.com/plugins/payments/request
# for a Jamaica-verified account. Use JMD or USD as approved for your account.
WIPAY_ACCOUNT_NUMBER=
WIPAY_CHECKOUT_URL=
WIPAY_COUNTRY_CODE=JM
WIPAY_CURRENCY=JMD
WIPAY_FEE_STRUCTURE=merchant_absorb

# PayPal — Payouts API (host payout gateway, alternative to Stripe Connect).
# https://developer.paypal.com/dashboard/applications for client id/secret.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# AWS IVS and private S3 event-image storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_REGION=us-east-1

# Platform commission for Package B (default: 15)
COMMISSION_PERCENT=15
